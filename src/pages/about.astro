---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Francois Gerber - About">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Who Am I?</div>
  </div>

  <div class="mb-10 text-justify">
    I am a passionate Software Developer dedicated to delivering high-quality scalable solutions. 
    <br /><br />
    My enthusiasm for problem-solving drives me to continuously expand my knowledge in software development. I embrace daily learning opportunities and strive to excel in every task.
    <br />
    My expertise lies in data-driven software solutions, specializing in the .NET Web Stack. I thrive in both solo projects and collaborative team environments, always eager to learn and support others in achieving their objectives. 
    <br />
    With a quick problem-solving ability and a solutions-oriented mindset, I distinguish myself as a capable leader.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Details</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="Full Names" subtitle="Francois Gerber" />
    <TimeLineElement title="Location" subtitle="Flick en Flac, Mauritius" />
    <TimeLineElement title="Gender" subtitle="Male" />
    <TimeLineElement title="Marital Status" subtitle="Married" />
    <TimeLineElement
      title="Transport"
      subtitle="Own Vehicle and valid Code B drivers license"
    />
    <TimeLineElement
      title="Home Language"
      subtitle="English (Strong/Fluent: Reading, Written, Spoken – Business Level)"
    />
    <TimeLineElement
      title="Other Languages"
      subtitle="Afrikaans (Native: Reading, Written, Spoken – Business Level)"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Tertiary: MCSD"
      subtitle="2013 to 2015 at WW.IT-IQ Training & Solutions"
    />

    <TimeLineElement
      title="High School: Matric (Grade 12)"
      subtitle="2008 to 2012 at High School Lydenburg"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Senior .Net Full Stack Developer"
      subtitle="From 2022 at Ringier South Africa"
      desc="While working at Ringier SA, I contributed towards an internal dynamic crawling solution, used for Market Intelligence and data collection in the Marketplaces space of the company. I used various web technologies including .NET, python, AWS, NodeJs, Vue and React frontend frameworks."
    />
    <TimeLineElement
      title=".NET Full Stack Software Developer"
      subtitle="From 2015 till 2022 at BlueMonday PTY (LTD)"
      desc="While working at Blue Monday, I worked on various business solutions for clients and internal tools and systems. I gained experience in various web technologies including Angular, Ionic, Blazor.NET and backend technologies like ASP.NET Web API, WCF and NodeJS."
    />
    <TimeLineElement
      title="Student Developer"
      subtitle="From 2013 till 2015 at WW.IT-IQ Training & Solutions"
      desc="While studying, I worked on programs assigned to me by my lecturers and other programs I thought businesses/people could or would like to use, as well as projects commissioned by clients."
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      MCSD – Microsoft® Certified Solutions Developer – Web Applications,
      including HTML5, ASP.Net MVC, Windows Azure (Cloud Development)
    </li>
    <li>MCSD - Microsoft® Certified Solutions Developer – App Builder</li>
    <li>Microsoft® Certified SQL Specialist</li>
    <li>Microsoft® Certified Professional</li>
    <li>Microsoft® Certified Technology Associate – Networking Fundamentals</li>
    <li>Microsoft® Certified Technology Specialist – Accessing Data</li>
    <li>Microsoft® Certified Specialist – C# & HTML5, CSS3 & JavaScript</li>
    <li><a href="https://www.udemy.com/certificate/UC-8e7990b0-0435-44f2-9f47-96e3aba9c208/" target="_blank">Go - The Complete Guide - Udemy</a></li>
    <li><a href="https://www.udemy.com/certificate/UC-ceaafd51-c8b4-4308-8fb6-acb1faba862f/" target="_blank"></a>The Complete Python Developer - Udemy</a></li>
    <li><a href="https://www.udemy.com/certificate/UC-46488394-14f7-4caa-bcad-dd453edf05af/" target="_blank"></a>The Complete Prompt Engineering for AI Bootcamp (2025) - Udemy</a></li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>.NET</li>
    <li>C#</li>
    <li>Blazor</li>
    <li>ASP.NET</li>
    <li>Ionic/Cordova</li>
    <li>Nodejs</li>
    <li>JavaScript</li>
    <li>TypeScript</li>
    <li>Go (GoLang)</li>
    <li>Python</li>
    <li>SQL</li>
    <li>MongoDB</li>
    <li>ElasticSearch</li>
    <li>Redis</li>
    <li>Angular</li>
    <li>Vue</li>
    <li>React</li>
    <li>Git</li>
    <li>CI/CD</li>
    <li>Azure</li>
    <li>AWS</li>
    <li>Linux</li>
    <li>Web Applications</li>
    <li>Mobile Apps</li>
    <li>Web Scraping</li>
    <li>Distributed Systems</li>
    <li>Data Driven Solutions</li>
    <li>Architecture</li>
    <li>Creative Problem Solving</li>
    <li>Customer Experience</li>
  </ul>
</BaseLayout>
